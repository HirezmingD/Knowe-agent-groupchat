{
  "x-knowe-implementation": "[v1.0.13][R5]",
  "name": "knowe",
  "version": "1.0.39.1",
  "private": true,
  "license": "MIT",
  "description": "Command your Agent team through group chat",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "verify": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "lint": "eslint src/ electron/ --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "npx playwright test",
    "dev": "vite",
    "electron:dev": "electron-vite dev",
    "electron:start": "electron .",
    "preflight": "node scripts/preflight.mjs",
    "electron:build": "electron-vite build && node scripts/test-built-main.mjs && node scripts/write-build-manifest.mjs",
    "electron:preview": "electron-vite preview",
    "test:built-main": "node scripts/test-built-main.mjs",
    "build:manifest": "node scripts/write-build-manifest.mjs",
    "electron:build:clean": "node scripts/clean-electron-build.mjs && npm run electron:build",
    "icon:ico": "node scripts/make-icon-ico.mjs",
    "icon:icns": "node scripts/make-icon-icns.mjs",
    "copy:chromium": "node scripts/copy-chromium.mjs",
    "dist:win": "node scripts/clean-electron-build.mjs && npm run icon:ico && npm run electron:build && npm run copy:chromium && electron-builder --win nsis",
    "dist:mac": "node scripts/clean-electron-build.mjs && npm run icon:icns && npm run electron:build && npm run copy:chromium && electron-builder --mac"
  },
  "dependencies": {
    "@tiptap/extension-mention": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "i18next": "^26.3.6",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^1.6.0",
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HirezmingD/Knowe-agent-groupchat.git"
  },
  "author": "Hezhou Jiang",
  "keywords": [
    "electron",
    "react",
    "python",
    "ai-agents",
    "group-chat"
  ]
}